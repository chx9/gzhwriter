# ── 模型 ─────────────────────────────────────────────
# 提供商：openai（Chat Completions）或 anthropic（Messages API）。
# 不填时自动判断：有 ANTHROPIC_AUTH_TOKEN 用 anthropic，否则用 openai。
GZH_PROVIDER=
GZH_MODEL=

# ── Anthropic 兼容（Claude Code 同款网关）──
# 例如 Tencent TokenHub：https://tokenhub.tencentmaas.com/plan/anthropic
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_VERSION=2023-06-01
GZH_MAX_TOKENS=1000000

# ── OpenAI 兼容 ──
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# 任一提供商都没配 Key 时自动进入演示模式（UI 会明确标识）。

# 强制演示模式（即使有 Key）
# GZH_DEMO=1

# ── 数据 ─────────────────────────────────────────────
# 所有项目、SQLite、主题、风格都在这里；不会写 DSH 的目录。
GZH_DATA_DIR=./workspace
# GZH_PROJECTS_ROOT=./workspace/wechat-projects
# GZH_STYLES_ROOT=./workspace/styles
# GZH_DB=./workspace/gzh.sqlite

# ── 写作默认值 ───────────────────────────────────────
GZH_AUTHOR=
GZH_THEME=wechat
GZH_TARGET_CHARS=2800
GZH_MAX_REVIEW_ROUNDS=3
# strip | references | footnotes
GZH_CITATION_MODE=strip

# 首次启动生成示例文章；不想要就设 0
GZH_SEED=1

# B 站字幕：浏览器登录态（chrome / safari / edge / firefox…）或 cookies.txt
# 字幕轨道通常需要登录；读 Chrome Cookie 前最好先退出 Chrome
# GZH_BILIBILI_BROWSER=chrome
# GZH_BILIBILI_COOKIE_FILE=/path/to/cookies.txt

# ── 服务 ─────────────────────────────────────────────
GZH_HOST=127.0.0.1
GZH_PORT=8765
GZH_REQUEST_TIMEOUT=300
GZH_MAX_CONTEXT_CHARS=48000
GZH_LOG_LEVEL=INFO
